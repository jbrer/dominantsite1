# Скопируйте этот файл в .env и при необходимости поправьте путь.
#   cp .env.example .env
#
# ВАЖНО: относительный путь считается от файла prisma/schema.prisma,
# поэтому "../db/custom.db" указывает на db/custom.db в корне проекта.
# Такой вариант работает одинаково на Windows, macOS и Linux.
DATABASE_URL=file:../db/custom.db

# Пароль входа в админку (/admin/login). Обязательно поменяйте на свой.
ADMIN_PASSCODE=dominant2026
